# IWSM Website & Options Simulator — Server-Side Environment Template
# Copy Alice Blue settings to %LOCALAPPDATA%\IWSM\aliceblue.env for local runs.
# Never commit real credentials or session tokens to Git.

ALICEBLUE_APP_CODE=your_aliceblue_vendor_app_code
ALICEBLUE_API_SECRET=your_aliceblue_api_secret
ALICEBLUE_CLIENT_ID=your_aliceblue_user_id
ALICEBLUE_REDIRECT_URL=http://127.0.0.1:4174/api/aliceblue/auth/callback
ALICEBLUE_SESSION_ENCRYPTION_KEY=
ALICEBLUE_BASE_URL=https://a3.aliceblueonline.com
ALICEBLUE_DEFAULT_EXCHANGE=nse_fo
ALICEBLUE_REFRESH_SECONDS=5
ALICEBLUE_SNAPSHOT_DB_PATH=
